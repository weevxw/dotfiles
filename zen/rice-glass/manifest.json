{
  "manifest_version": 3,
  "name": "Rice Glass",
  "version": "1.1.0",
  "description": "Keeps Zen see-through under niri, except while a video plays. Adds Catppuccin accents.",
  "browser_specific_settings": { "gecko": { "id": "rice-glass@dotfiles" } },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": ["video-glass.js"],
      "css": ["catppuccin.css"]
    }
  ]
}
